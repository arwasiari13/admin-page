rules_version = '2';

// Time Up — Firestore security rules.
// Publish them from Firebase Console → Firestore Database → Rules (paste all of this, then Publish).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function codePath(code) {
      return /databases/$(database)/documents/codes/$(code);
    }

    // The account can use the app: not disabled, and its subscription has not ended.
    // Accounts without expiresAt (created before codes existed) have no end date.
    function accountOpen(uid) {
      let u = get(/databases/$(database)/documents/users/$(uid)).data;
      return u.get('active', true) != false
        && (u.get('expiresAt', null) == null || u.get('expiresAt', null) > request.time);
    }

    // Sign-up with a code: the new user writes their own profile, in the same transaction
    // that marks the code as used. Duration is copied from the code, and the end date must
    // be "now + that many months" (with a few days of tolerance for month lengths / clock).
    function validSignup(uid) {
      let data = request.resource.data;
      let codeBefore = get(codePath(data.code)).data;
      let codeAfter = getAfter(codePath(data.code)).data;
      return data.keys().hasOnly(['username', 'password', 'code', 'durationMonths', 'expiresAt', 'active', 'role', 'createdAt'])
        && data.username is string
        && request.auth.token.email == data.username + '@timeup.app'
        && data.password is string
        && codeBefore.used == false
        && codeAfter.used == true
        && codeAfter.usedBy == uid
        && data.durationMonths == codeBefore.durationMonths
        && data.expiresAt is timestamp
        && data.expiresAt > request.time + duration.value(data.durationMonths * 28 - 1, 'd')
        && data.expiresAt < request.time + duration.value(data.durationMonths * 31 + 2, 'd')
        && data.active == true
        && data.role == 'user'
        && data.createdAt == request.time;
    }

    // Admins: every admin can see the list and add/remove other admins.
    // Nobody can delete their own admin record, so the panel always keeps at least one admin.
    match /admins/{adminId} {
      allow get: if signedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && request.auth.uid != adminId;
    }

    // Access codes: generated by admins. Anyone may look up one code by its exact value
    // (to check it before signing up) — codes cannot be listed.
    // A new user can only flip an unused code to "used by me", together with creating their profile.
    match /codes/{code} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.used == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedByUsername', 'usedAt'])
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.code == code
      );
    }

    // Feedback from the app: anonymous. Any signed-in user can send one;
    // only these fields are accepted, so no name or user id can be stored.
    // Only admins can read, mark as read, or delete.
    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['message', 'rating', 'platform', 'appVersion', 'read', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // App users: profile readable by the user and by admins.
    // Created by the user themself (sign-up with a code) or by an admin; changed only by admins
    // (renewing, disabling…).
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && validSignup(uid));
      allow update, delete: if isAdmin();

      // The user's own data (subscribers, offers…): admins, or the user while their
      // subscription is running. Once it ends the data is kept but locked until renewal.
      match /{document=**} {
        allow read, write: if isAdmin() || (signedIn() && request.auth.uid == uid && accountOpen(uid));
      }
    }
  }
}
