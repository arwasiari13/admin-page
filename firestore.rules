rules_version = '2';

// Time Up — Firestore security rules.
// Publish them from Firebase Console → Firestore Database → Rules (paste all of this, then Publish).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins: every admin can see the list and add/remove other admins.
    // Nobody can delete their own admin record, so the panel always keeps at least one admin.
    match /admins/{adminId} {
      allow get: if signedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && request.auth.uid != adminId;
    }

    // Feedback from the app: anonymous. Any signed-in user can send one;
    // only these fields are accepted, so no name or user id can be stored.
    // Only admins can read, mark as read, or delete.
    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['message', 'rating', 'platform', 'appVersion', 'read', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // App users: profile written only by admins; readable by the user and by admins.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();

      // The user's own data (subscribers, offers…): the user and admins.
      match /{document=**} {
        allow read, write: if signedIn() && (request.auth.uid == uid || isAdmin());
      }
    }
  }
}
